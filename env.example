PORT=3000

# 必填:随机长字符串,用于签发登录 token(无默认值,缺失时服务拒绝启动)
JWT_SECRET=change-me-in-production

# 可选:管理员手机号,该账号登录后可查看全站订单;不配置则无人是管理员
ADMIN_PHONE=

# MySQL 连接(必填)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=travel

# AI 助手:POST /api/assistant 会把请求体 JSON 原样转发到该地址(可与 AI_API_URL 二选一)
ASSISTANT_UPSTREAM_URL=https://your-api.example.com/v1/chat
# 兼容别名
# AI_API_URL=https://your-api.example.com/v1/chat

# 若上游需要 Bearer,填写;不需要则留空
ASSISTANT_UPSTREAM_KEY=

# 渝小智 Agent 会话 /api/agent-chat 的上游(客户端未填 API Key 时回落到这里)
DEEPSEEK_UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_UPSTREAM_KEY=
DEEPSEEK_MODEL=deepseek-chat
